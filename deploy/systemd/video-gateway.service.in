[Unit]
Description=Local Video API Gateway
After=mediamtx-local.service
Wants=mediamtx-local.service

[Service]
Type=simple
WorkingDirectory=@PROJECT_DIR@
Environment=MEDIAMTX_API_URL=http://127.0.0.1:9997
ExecStart=@PROJECT_DIR@/scripts/run-gateway.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
